[mysqld]
# Configuration des ports et de l'utilisateur système
user                    = mysql
pid-file                = /run/mysqld/mysqld.pid
socket                  = /run/mysqld/mysqld.sock
port                    = 3306
basedir                 = /usr
datadir                 = /var/lib/mysql
tmpdir                  = /tmp
lc-messages-dir         = /usr/share/mysql

# Autoriser MariaDB à écouter sur toutes les interfaces réseau du conteneur
bind-address            = 0.0.0.0

# Sécurité et performances de base
query_cache_size        = 16M
log_error               = /var/log/mysql/error.log
expire_logs_days        = 10
